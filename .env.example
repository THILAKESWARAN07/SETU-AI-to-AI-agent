# ==============================================================================
# SETU — AI Commerce Trust Layer Environment Variables Template
#
# Copy this file to '.env' and fill in your actual private credentials.
# WARNING: Do NOT commit '.env' or expose private API/Payment keys to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI LLM Provider Configuration
# ------------------------------------------------------------------------------
# Active AI provider adapter to use. Supported values: 'gemini', 'openai', 'mock'
LLM_PROVIDER=mock

# Google Gemini API key (needed if LLM_PROVIDER is set to 'gemini')
# Can be retrieved from Google AI Studio.
GEMINI_API_KEY=

# OpenAI API key (needed if LLM_PROVIDER is set to 'openai')
OPENAI_API_KEY=

# Generic LLM API key fallback (optionally checked by the adapter runtime)
LLM_API_KEY=

# Model identifier override (e.g., 'gemini-3.6-flash', 'gpt-4-turbo')
LLM_MODEL=gemini-3.6-flash

# Whether the agent runtime should automatically downgrade to local mock mode
# if the live model API throws rate limit limits (HTTP 429).
LLM_FALLBACK_TO_MOCK=True


# ------------------------------------------------------------------------------
# 2. Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Active payment gateway method. Supported values: 'razorpay', 'mock'
# If set to 'razorpay' and valid test mode credentials are provided, checkout order
# generation is routed to Razorpay. Otherwise, defaults to mock mode.
PAYMENT_MODE=mock

# Razorpay API Test Mode credentials (retrieved from Razorpay Dashboard in Test Mode)
# The Key ID must start with 'rzp_test_'.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=

# Secret token used by the server to cryptographically verify signature payloads
# returned by Razorpay webhooks (e.g. order.paid event).
RAZORPAY_WEBHOOK_SECRET=


# ------------------------------------------------------------------------------
# 3. Database & Security Configurations
# ------------------------------------------------------------------------------
# Database connection URL. Default is a local SQLite file database.
DATABASE_URL=sqlite:///./setu.db

# Cryptographic secret used for signing backend security tokens/sessions
SECRET_KEY=setu-trust-layer-secret-key-12938
