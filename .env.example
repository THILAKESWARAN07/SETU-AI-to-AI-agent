# ==============================================================================
# SETU — AI Commerce Trust Layer Environment Variables Template
#
# Copy this file to '.env' and fill in your actual private credentials.
# WARNING: Do NOT commit '.env' or expose private API/Payment keys to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Free Multi-Provider AI LLM Configuration
# ------------------------------------------------------------------------------
# Buyer Agent LLM Provider Configuration (Primary: Gemini)
BUYER_LLM_PROVIDER=gemini
BUYER_LLM_MODEL=gemini-3.1-flash-lite
BUYER_LLM_FALLBACKS=openrouter,groq,mock

# Merchant Agent LLM Provider Configuration (Primary: Groq)
MERCHANT_LLM_PROVIDER=groq
MERCHANT_LLM_MODEL=llama-3.3-70b-versatile
MERCHANT_LLM_FALLBACKS=openrouter,gemini,mock

# Auxiliary Non-Critical AI Tasks Configuration (Primary: Groq)
AUXILIARY_LLM_PROVIDER=groq
AUXILIARY_LLM_MODEL=llama-3.3-70b-versatile
AUXILIARY_LLM_FALLBACKS=gemini,openrouter,mock

# Model IDs for Free-Tier Providers
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Legacy / Global Fallback Provider Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_TO_MOCK=true
LLM_TIMEOUT_SECONDS=25.0
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 2. Free AI Provider API Keys
# ------------------------------------------------------------------------------
# Google Gemini API key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API key (from https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter API key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Generic LLM API key fallback
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 3. Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Active payment gateway method. Supported values: 'razorpay', 'mock'
PAYMENT_MODE=mock

# Razorpay API Test Mode credentials (retrieved from Razorpay Dashboard in Test Mode)
# The Key ID must start with 'rzp_test_'.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. Database & Security Configurations
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./setu.db
SECRET_KEY=setu-trust-layer-secret-key-12938
